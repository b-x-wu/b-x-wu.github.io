---
import Font from "astro/components/Font.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import ResetStyles from "~/styles/ResetStyles.astro";
import StyleTokens from "~/styles/StyleTokens.astro";
import UtilityStyles from "~/styles/UtilityStyles.astro";

interface Props { title: string; }

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<Font cssVariable="--font-ubuntu-mono" />
		<title>{title}</title>
	</head>
	<body>
		<div class="wrapper">
			<Header />
			<main>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<ResetStyles />
<StyleTokens />
<UtilityStyles />

<style is:global>
	html {
		font-family: var(--font-ubuntu-mono), system-ui, sans-serif;
	}

	body {
		background-color: var(--color-bg);
		color: var(--color-text);
		height: 100dvh;
		display: flex;
		flex-direction: column;
		place-items: center;
		justify-content: center;
	}

	.wrapper {
		position: relative;
		display: flex;
		flex-direction: column;
		max-width: 80%;
		width: 640px;
		height: 100%;
	}

	main {
		flex-grow: 1;
		overflow: scroll;
	}
</style>

<script>
	import { initializeStores } from '~/lib/store';
	initializeStores();
</script>
