---
import { Image } from "astro:assets";
import createReactSandboxPreview from "~/assets/images/project-previews/create-react-sandbox-preview.gif";
import palettePosterizationPreview from "~/assets/images/project-previews/palette-posterization-preview.png";
import palettePosterizationPreviewDark from "~/assets/images/project-previews/palette-posterization-preview-dark.png";
import pixelSvgMakerPreview from "~/assets/images/project-previews/pixel-svg-maker-preview.png";
import pixelSvgMakerPreviewDark from "~/assets/images/project-previews/pixel-svg-maker-preview-dark.png";
import visualNovelTerminalPreview from "~/assets/images/project-previews/visual-novel-terminal-preview.gif";
import Chat from "~/components/layout/Chat.astro";
import Chatbox from "~/components/layout/Chatbox.astro";
import ProjectPreview from "~/components/pages/projects/ProjectPreview.astro";
import Window from "~/components/pages/projects/Window.astro";
import Layout from "~/layouts/Layout.astro";

const CREATE_REACT_SANDBOX_URL =
  "https://www.npmjs.com/package/create-react-sandbox";
const VISUAL_NOVEL_TERMINAL_URL =
  "https://bruce-x-wu.itch.io/visual-novel-terminal";
---

<Layout title="b-x-wu | Projects">
  <Chat>
    <Chatbox>here’s some stuff i've worked on in my free time</Chatbox>
    <Chatbox>check it out !!</Chatbox>
    <div class="projects">
      <Window
        title="Pixel SVG Maker"
        description="Exporting pixel art to SVG"
        link="/projects/pixel-svg-maker"
      >
        <a class="previewLink" href="/projects/pixel-svg-maker">
          <ProjectPreview
            id="pixel-svg-maker-preview-dark"
            fallback="Loading Pixel SVG Maker preview"
            themeMode="dark"
          >
            <Image
              src={pixelSvgMakerPreviewDark}
              alt="Pixel SVG Maker preview"
              class="pixelSvgMakerPreviewImage"
              loading="lazy"
            />
          </ProjectPreview>
          <ProjectPreview
            id="pixel-svg-maker-preview-light"
            fallback="Loading Pixel SVG Maker preview"
            themeMode="light"
          >
            <Image
              src={pixelSvgMakerPreview}
              alt="Pixel SVG Maker preview"
              class="pixelSvgMakerPreviewImage"
              loading="lazy"
            />
          </ProjectPreview>
        </a>
      </Window>
      <Window
        title="Create React Sandbox"
        description="Lightweight React environments"
        link={CREATE_REACT_SANDBOX_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        <a
          class="previewLink"
          href={CREATE_REACT_SANDBOX_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            id="create-react-sandbox-preview-background"
            class="previewBackground"
            src={createReactSandboxPreview.src}
            alt=""
            aria-hidden="true"
          >
          <div class="previewOverlay" />
          <ProjectPreview
            id="create-react-sandbox-preview"
            fallback="Loading Create React Sandbox preview"
          >
            <img
              src={createReactSandboxPreview.src}
              alt="Create React Sandbox preview"
              class="createReactSandboxPreviewImage"
            >
          </ProjectPreview>
        </a>
      </Window>
      <Window
        title="Visual Novel Terminal"
        description="A customizable terminal reskin"
        link={VISUAL_NOVEL_TERMINAL_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        <a
          class="previewLink"
          href={VISUAL_NOVEL_TERMINAL_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <ProjectPreview
            id="visual-novel-terminal-preview"
            fallback="Loading Visual Novel Terminal preview"
          >
            <img
              src={visualNovelTerminalPreview.src}
              alt="Visual Novel Terminal preview"
              class="visualNovelTerminalPreviewImage"
            >
          </ProjectPreview>
        </a>
      </Window>
      <Window
        title="Palette Posterizer"
        description="Customizable image posterization"
        link="/projects/palette-posterizer"
      >
        <a class="previewLink" href="/projects/palette-posterizer">
          <ProjectPreview
            id="palette-posterizer-preview-dark"
            fallback="Loading Palette Posterizer preview"
            themeMode="dark"
          >
            <Image
              src={palettePosterizationPreviewDark}
              alt="Palette Posterizer preview"
              class="palettePosterizerPreviewImage"
              loading="lazy"
            />
          </ProjectPreview>
          <ProjectPreview
            id="palette-posterizer-preview-light"
            fallback="Loading Palette Posterizer preview"
            themeMode="light"
          >
            <Image
              src={palettePosterizationPreview}
              alt="Palette Posterizer preview"
              class="palettePosterizerPreviewImage"
              loading="lazy"
            />
          </ProjectPreview>
        </a>
      </Window>
    </div>
  </Chat>
</Layout>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (--md) {
    .projects {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .previewLink {
    position: relative;
    display: block;
    height: 256px;
  }

  .previewBackground {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  .previewOverlay {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(4px);
  }

  .pixelSvgMakerPreviewImage {
    object-fit: cover;
    object-position: top;
  }

  .palettePosterizerPreviewImage {
    object-fit: cover;
  }

  .createReactSandboxPreviewImage {
    object-fit: contain;
  }

  .visualNovelTerminalPreviewImage {
    object-fit: cover;
    object-position: bottom;
  }
</style>

<script>
  import createReactSandboxPreview from "~/assets/images/project-previews/create-react-sandbox-preview.gif";
  import createReactSandboxPreviewReducedMotion from "~/assets/images/project-previews/create-react-sandbox-preview-reduced-motion.png";
  import visualNovelTerminalPreview from "~/assets/images/project-previews/visual-novel-terminal-preview.gif";
  import visualNovelTerminalPreviewReducedMotion from "~/assets/images/project-previews/visual-novel-terminal-preview-reduced-motion.png";
  import { getById, getBySelector } from "~/lib/dom";
  import { motionStore, normalizeLocalStoreMotionMode } from "~/lib/settings";

  const swapPreviewImage = (previewId: string, src: string): void => {
    const previewNode = getById(previewId);
    const imageNode = getBySelector<HTMLImageElement>(previewNode, "img");
    previewNode.dataset.imageState = "pending";
    imageNode.src = src;

    // cached images can finish loading before the load event fires
    if (imageNode.complete) {
      previewNode.dataset.imageState =
        imageNode.naturalWidth > 0 ? "loaded" : "error";
    }
  };

  motionStore.subscribe((value) => {
    const motionMode = normalizeLocalStoreMotionMode(value);
    const isReducedMotion = motionMode === "reduced";
    const sandboxSrc = isReducedMotion
      ? createReactSandboxPreviewReducedMotion.src
      : createReactSandboxPreview.src;

    getById<HTMLImageElement>("create-react-sandbox-preview-background").src =
      sandboxSrc;
    swapPreviewImage("create-react-sandbox-preview", sandboxSrc);
    swapPreviewImage(
      "visual-novel-terminal-preview",
      isReducedMotion
        ? visualNovelTerminalPreviewReducedMotion.src
        : visualNovelTerminalPreview.src,
    );
  });
</script>
