---
import type { ColorToken } from "~/styles/tokens";

type Props = {
  "aria-label": string;
  id: string;
  src: string;
  href: string;
  rel?: string;
  target?: astroHTML.JSX.HTMLAttributeAnchorTarget;
  color?: ColorToken;
};
const {
  "aria-label": ariaLabel,
  src,
  id,
  href,
  rel,
  target,
  color = "text",
} = Astro.props;
---

<a
  class="root"
  aria-label={ariaLabel}
  id={id}
  href={href}
  rel={rel}
  target={target}
>
  <span
    class:list={["bg-clip", "icon"]}
    style={{
      "--bg-image": `url(${src})`,
      "--icon-color": `var(--color-${color})`,
    }}
  />
</a>

<style>
  .root {
    background-color: transparent;
    height: 24px;
    width: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon {
    background-color: var(--icon-color);
    height: 20px;
    width: 20px;
  }
</style>
