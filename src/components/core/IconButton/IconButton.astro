---
import type { IconButtonProps } from "./utils";

type Props = IconButtonProps;
const { "aria-label": ariaLabel, src, id } = Astro.props;
---

<button class="root" aria-label={ariaLabel} id={id} type="button">
  <span
    class:list={["bg-clip", "icon"]}
    style={{ '--bg-image': `url(${src})` }}
  />
</button>

<style>
  .root {
    background-color: transparent;
    height: 24px;
    width: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon {
    display: block;
    background-color: var(--color-text);
    height: 20px;
    width: 20px;
  }
</style>
