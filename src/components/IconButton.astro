---
import type { IconButtonProps } from '~/lib/utils';

type Props = IconButtonProps;
const { 'aria-label': ariaLabel, src, "data-tag": dataTag } = Astro.props;
---
<button class="root" aria-label={ariaLabel} data-tag={dataTag}>
    <div class:list={["bg-clip", "icon"]} style={{ '--bg-image': `url(${src})` }} />
</button>

<style>
    .root {
        background-color: transparent;
        height: 24px;
        width: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon {
        background-color: var(--color-text);
        height: 16px;
        width: 16px;
    }
</style>