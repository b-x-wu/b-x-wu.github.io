---
import lightModeIcon from '../assets/light-mode.svg'
import lowContrastIcon from '../assets/low-contrast.svg'
import reducedMotionIcon from '../assets/reduced-motion.svg'
import IconButton from './IconButton.astro'

type Props = Record<string, never>
---

<header>
    <nav>
        <a class="homeLink" href="/" aria-label="Home">b-x-wu!</a>
        <a href="/" aria-label="Resumé">/resume</a>
        <a href="/" aria-label="Projects">/projects</a>
    </nav>
    <div class="toolbar">
        <IconButton aria-label="Disable dark mode" src={lightModeIcon.src} data-tag='theme-button' />
        <IconButton aria-label="Enable low contrast mode" src={lowContrastIcon.src} data-tag='contrast-button' />
        <IconButton aria-label="Enable reduced motion mode" src={reducedMotionIcon.src} data-tag='motion-button' />
    </div>
</header>

<style>
    header {
        flex: none;
        padding: 36px 0;
        flex-shrink: 1;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }

    nav {
        display: flex;
        flex-direction: row;
        column-gap: 48px;
    }

    a {
        height: fit-content;
        text-decoration: none;
        color: var(--color-text);
    }

    a:hover {
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    a.homeLink {
        color: var(--color-primary);
        font-weight: bold;
    }

    .toolbar {
        display: flex;
        flex-direction: row;
        column-gap: 4px;
    }
</style>