---
import configMenuClosedIcon from "~/assets/icons/config-menu-closed.svg";
import lightModeIcon from "~/assets/icons/light-mode.svg";
import lowContrastIcon from "~/assets/icons/low-contrast.svg";
import reducedMotionIcon from "~/assets/icons/reduced-motion.svg";
import IconButton from "~/components/core/IconButton/IconButton.astro";
import Menu from "~/components/core/Menu/Menu.astro";
import MenuItem from "~/components/core/Menu/MenuItem.astro";
import ResponsiveVisibility from "~/components/core/ResponsiveVisibility/ResponsiveVisibility.astro";

type Props = Record<string, never>;
---

<header>
  <nav>
    <a class="homeLink" href="/" aria-label="Home">b-x-wu!</a>
    <a href="/resume" aria-label="Resumé">/resume</a>
    <a href="/" aria-label="Projects">/projects</a>
  </nav>
  <ResponsiveVisibility>
    <div class="toolbar">
      <IconButton
        aria-label="Enable light mode"
        src={lightModeIcon.src}
        id="theme-button"
      />
      <IconButton
        aria-label="Enable low contrast mode"
        src={lowContrastIcon.src}
        id="contrast-button"
      />
      <IconButton
        aria-label="Enable reduced motion mode"
        src={reducedMotionIcon.src}
        id="motion-button"
      />
    </div>
    <span slot="xs">
      <IconButton
        id="config-menu-trigger"
        src={configMenuClosedIcon.src}
        aria-label="Open config menu"
      />
      <Menu id="config-menu" placement="right">
        <MenuItem
          id="theme-menuitem"
          iconSrc={lightModeIcon.src}
          label="Enable light mode"
        />
        <MenuItem
          id="contrast-menuitem"
          iconSrc={lowContrastIcon.src}
          label="Enable low contrast mode"
        />
        <MenuItem
          id="motion-menuitem"
          iconSrc={reducedMotionIcon.src}
          label="Enable reduced motion mode"
        />
      </Menu>
    </span>
  </ResponsiveVisibility>
</header>

<style>
  header {
    flex: none;
    padding: 36px 0;
    flex-shrink: 1;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  nav {
    display: flex;
    flex-direction: row;
    column-gap: 48px;
  }

  a {
    height: fit-content;
    text-decoration: none;
    color: var(--color-text);
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  a.homeLink {
    color: var(--color-primary);
    font-weight: bold;
  }

  .toolbar {
    display: flex;
    flex-direction: row;
    column-gap: 4px;
  }
</style>

<script>
  import configMenuClosedIcon from "~/assets/icons/config-menu-closed.svg";
  import configMenuOpenIcon from "~/assets/icons/config-menu-open.svg";
  import darkModeIcon from "~/assets/icons/dark-mode.svg";
  import highContrastIcon from "~/assets/icons/high-contrast.svg";
  import lightModeIcon from "~/assets/icons/light-mode.svg";
  import lowContrastIcon from "~/assets/icons/low-contrast.svg";
  import noReducedMotionIcon from "~/assets/icons/no-reduced-motion.svg";
  import reducedMotionIcon from "~/assets/icons/reduced-motion.svg";
  import { updateIconButton } from "~/components/core/IconButton/utils";
  import { createMenu, updateMenuItem } from "~/components/core/Menu/utils";
  import {
    contrastStore,
    getNormalizedContrastMode,
    getNormalizedMotionMode,
    getNormalizedTheme,
    motionStore,
    themeStore,
  } from "~/lib/store";
  import { getById } from "~/lib/utils";

  themeStore.subscribe((value) => {
    const theme = getNormalizedTheme(value);
    if (theme === "dark") {
      updateIconButton("theme-button", {
        "aria-label": "Enable light mode",
        src: lightModeIcon.src,
      });
      updateMenuItem("theme-menuitem", {
        label: "Enable light mode",
        iconSrc: lightModeIcon.src,
      });
    } else {
      // light mode
      updateIconButton("theme-button", {
        "aria-label": "Enable dark mode",
        src: darkModeIcon.src,
      });
      updateMenuItem("theme-menuitem", {
        label: "Enable dark mode",
        iconSrc: darkModeIcon.src,
      });
    }
  });

  const toggleTheme = () => {
    const theme = getNormalizedTheme();
    if (theme === "dark") {
      themeStore.set("light");
    } else {
      // light mode
      themeStore.set("dark");
    }
  };

  getById("theme-button").addEventListener("click", toggleTheme);
  getById("theme-menuitem").addEventListener("click", toggleTheme);

  contrastStore.subscribe((value) => {
    const contrastMode = getNormalizedContrastMode(value);
    if (contrastMode === "default") {
      updateIconButton("contrast-button", {
        "aria-label": "Enable high contrast mode",
        src: highContrastIcon.src,
      });
      updateMenuItem("contrast-menuitem", {
        label: "Enable high contrast mode",
        iconSrc: highContrastIcon.src,
      });
    } else {
      // high contrast mode
      updateIconButton("contrast-button", {
        "aria-label": "Disable high contrast mode",
        src: lowContrastIcon.src,
      });
      updateMenuItem("contrast-menuitem", {
        label: "Disable high contrast mode",
        iconSrc: lowContrastIcon.src,
      });
    }
  });

  const toggleContrastMode = () => {
    const contrastMode = getNormalizedContrastMode();
    if (contrastMode === "default") {
      contrastStore.set("high");
    } else {
      // high contrast
      contrastStore.set("default");
    }
  };

  getById("contrast-button").addEventListener("click", toggleContrastMode);
  getById("contrast-menuitem").addEventListener("click", toggleContrastMode);

  motionStore.subscribe((value) => {
    const motionMode = getNormalizedMotionMode(value);
    if (motionMode === "default") {
      updateIconButton("motion-button", {
        "aria-label": "Enable reduced motion mode",
        src: reducedMotionIcon.src,
      });
      updateMenuItem("motion-menuitem", {
        label: "Enabled reduced motion mode",
        iconSrc: reducedMotionIcon.src,
      });
    } else {
      // reduced motion mode
      updateIconButton("motion-button", {
        "aria-label": "Disable reduced motion mode",
        src: noReducedMotionIcon.src,
      });
      updateMenuItem("motion-menuitem", {
        label: "Disable reduced motion mode",
        iconSrc: noReducedMotionIcon.src,
      });
    }
  });

  const toggleMotionMode = () => {
    const motionMode = getNormalizedMotionMode();
    if (motionMode === "default") {
      motionStore.set("reduced");
    } else {
      // reduced motion
      motionStore.set("default");
    }
  };

  getById("motion-button").addEventListener("click", toggleMotionMode);
  getById("motion-menuitem").addEventListener("click", toggleMotionMode);

  // wire up config menu
  createMenu({
    triggerId: "config-menu-trigger",
    menuId: "config-menu",
    onOpenChange: (state) => {
      if (state === "open") {
        updateIconButton("config-menu-trigger", {
          src: configMenuOpenIcon.src,
          "aria-label": "Close config menu",
        });
      } else {
        updateIconButton("config-menu-trigger", {
          src: configMenuClosedIcon.src,
          "aria-label": "Open config menu",
        });
      }
    },
  });
</script>
