---
type Props = Record<string, never>;
---

<div id="palette-posterizer-image-uploader" class="image-uploader">
  <div class="inner">
    <div class="browse">
      <button
        class="button"
        id="palette-posterizer-image-uploader-browse-button"
        type="button"
      >
        Browse files
      </button>
      <input
        id="palette-posterizer-image-uploader-file-input"
        class="file-input"
        type="file"
        accept="image/*"
      >
    </div>
    <hr class="separator">
    <div class="url">
      <input
        id="palette-posterizer-image-uploader-url-input"
        class="url-input"
        type="text"
        placeholder="Upload from URL"
      >
      <button
        class="button"
        id="palette-posterizer-image-uploader-upload-button"
        type="button"
      >
        Upload
      </button>
    </div>
  </div>
</div>

<style>
  .image-uploader {
    display: flex;
    height: 256px;
    width: 100%;
    border: 2px solid var(--color-text);
  }

  .image-uploader[hidden] {
    display: none;
  }

  .inner {
    display: flex;
    flex-direction: column;
    row-gap: 16px;
    height: fit-content;
    width: 100%;
    margin-block: auto;
  }

  .browse {
    margin-inline: auto;
  }

  .file-input {
    display: none;
  }

  .button {
    color: var(--color-enabled);
    background-color: var(--color-bg);
  }

  .button:enabled:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .button:disabled {
    color: var(--color-muted);
    cursor: default;
  }

  .separator {
    border: none;
  }

  .separator::before {
    content: "~~~ or ~~~";
    display: block;
    text-align: center;
    color: var(--color-muted);
    font-size: var(--font-xs);
  }

  .url {
    display: flex;
    flex-direction: row;
    column-gap: 16px;
    margin-inline: auto;
    max-width: 80%;
  }

  .url-input {
    width: 384px;
    max-width: 100%;
    border: 2px solid var(--color-text);
    background-color: var(--color-bg);
    padding-inline: 4px;
    color: var(--color-text);
  }

  .url-input::placeholder {
    color: var(--color-muted);
  }
</style>

<script>
  import { getById } from "~/lib/dom";
  import { stateStore } from "./state";

  const fileInput = getById<HTMLInputElement>(
    "palette-posterizer-image-uploader-file-input",
  );
  const urlInput = getById<HTMLInputElement>(
    "palette-posterizer-image-uploader-url-input",
  );
  const browseButton = getById<HTMLButtonElement>(
    "palette-posterizer-image-uploader-browse-button",
  );
  const uploadButton = getById<HTMLButtonElement>(
    "palette-posterizer-image-uploader-upload-button",
  );

  const setLoading = (isLoading: boolean) => {
    browseButton.disabled = isLoading;
    uploadButton.disabled = isLoading;
  };

  const loadImage = (src: string, revoke?: () => void) => {
    setLoading(true);
    const image = new Image();

    image.addEventListener(
      "load",
      () => {
        setLoading(false);
        revoke?.();
        stateStore.setKey("image", image);
      },
      false,
    );

    image.addEventListener(
      "error",
      () => {
        setLoading(false);
        revoke?.();
      },
      false,
    );

    image.crossOrigin = "anonymous";
    image.src = src;
  };

  browseButton.addEventListener("click", () => {
    fileInput.click();
  });

  uploadButton.addEventListener("click", () => {
    const urlTextValue = urlInput.value;
    loadImage(
      urlTextValue.includes("://") ? urlTextValue : `//${urlTextValue}`,
    );
  });

  fileInput.addEventListener("change", (event) => {
    const file =
      (event.currentTarget as HTMLInputElement).files?.item(0) ?? undefined;
    if (file === undefined) {
      return;
    }

    fileInput.value = "";

    const fileUrl = URL.createObjectURL(file);
    loadImage(fileUrl, () => URL.revokeObjectURL(fileUrl));
  });
</script>
