---
import clipboardIcon from "~/assets/icons/clipboard.svg";
import downloadIcon from "~/assets/icons/download.svg";
import eraserIcon from "~/assets/icons/eraser.svg";
import pencilIcon from "~/assets/icons/pencil.svg";
import IconButton from "~/components/core/IconButton/IconButton.astro";
import IconLink from "~/components/core/IconLink/IconLink.astro";
import Canvas from "./Canvas.astro";
---

<div class="tools">
  <div class="controls">
    <IconButton
      aria-label="Enable draw mode"
      src={pencilIcon.src}
      color="text"
      id="draw-mode-button"
    />
    <IconButton
      aria-label="Enable eraser mode"
      src={eraserIcon.src}
      color="muted"
      id="erase-mode-button"
    />
  </div>
  <div class="downloads">
    <IconLink
      aria-label="Download pixel art as SVG"
      src={downloadIcon.src}
      id="download-svg-anchor"
      href=""
    />
    <IconButton
      aria-label="Copy pixel art to clipboard as SVG"
      src={clipboardIcon.src}
      id="copy-svg-button"
    />
  </div>
</div>
<Canvas />

<style>
  .tools {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    margin: 16px 0;
  }

  .controls {
    display: flex;
    flex-direction: row;
    gap: 16px;
  }

  .downloads {
    display: flex;
    flex-direction: row;
    gap: 16px;
  }
</style>

<script>
  import { listenKeys } from "nanostores";
  import { updateIconButton } from "~/components/core/IconButton/utils";
  import { updateIconLink } from "~/components/core/IconLink/utils";
  import { getById } from "~/lib/dom";
  import { Mode, stateStore } from "./state";
  import { svgStringStore } from "./svg";

  const drawModeButton = getById("draw-mode-button");
  drawModeButton.addEventListener("click", () => {
    stateStore.setKey("mode", Mode.DRAW);
  });

  const eraseModeButton = getById("erase-mode-button");
  eraseModeButton.addEventListener("click", () => {
    stateStore.setKey("mode", Mode.ERASE);
  });

  listenKeys(stateStore, ["mode"], (state) => {
    updateIconButton("draw-mode-button", {
      color: state.mode === Mode.DRAW ? "text" : "muted",
    });

    updateIconButton("erase-mode-button", {
      color: state.mode === Mode.ERASE ? "text" : "muted",
    });
  });

  getById("copy-svg-button").addEventListener("click", () => {
    navigator.clipboard.writeText(svgStringStore.get());
  });

  svgStringStore.listen((svgString) => {
    updateIconLink("download-svg-anchor", {
      href: URL.createObjectURL(
        new Blob([svgString], { type: "image/svg+xml" }),
      ),
    });
  });
</script>
